# === Виртуальное окружение ===
venv/
env/
.venv/
.env/
**/pyvenv.cfg

# === Файлы Python ===
*.pyc
*.pyo
*.pyd
__pycache__/
*.so

# === Django (самое важное для вас) ===
# Кэш (чтобы точно не улетело)
*.cache
cache/
django_cache/

# Медиа-файлы (загруженные пользователями, если есть)
media/

# Собранные статические файлы (если есть команда collectstatic)
staticfiles/

# Миграции — обычно их хранят, кроме как в команде, но если проект учебный,
# можно и не пушить, чтобы не мусорить. Строка ниже закомментирована намеренно.
# db.sqlite3
# */migrations/*.py
# !*/migrations/__init__.py

# Файлы перевода (*.mo — скомпилированные, хранить не обязательно)
*.mo

# === База данных ===
# SQLite (часто используется в учебных проектах)
*.sqlite3
db.sqlite3

# === Файлы окружения и IDE ===
# Локальный файл с секретами
.env
.env.local
.env.*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Системное
.DS_Store
Thumbs.db

# === Логи ===
*.log
